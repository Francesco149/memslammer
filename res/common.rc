/* Shared Windows resources: icon, manifest, version info. The including .rc
 * defines MS_NAME and MS_DESCRIPTION; version.h is generated by the build. */
#include <windows.h>
#include "version.h"

1 ICON "memslammer.ico"
#ifndef MS_NO_MANIFEST  /* gpui embeds its own manifest */
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MS_VER_COMMA
 PRODUCTVERSION MS_VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", MS_DESCRIPTION
      VALUE "FileVersion", MS_VERSION_STR
      VALUE "InternalName", MS_NAME
      VALUE "OriginalFilename", MS_NAME ".exe"
      VALUE "ProductName", "memslammer"
      VALUE "ProductVersion", MS_VERSION_STR
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
